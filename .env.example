# ============================================
# Telegram Board Bot — Environment Variables
# ============================================
# এই ফাইলটি শুধু template।
# আসল মান Render-এ Environment Variables
# হিসেবে বসাতে হবে।
# ============================================

# ----- Required (must set in Render) -----
TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
OWNER_IDS=8678981488

# ----- Optional (has defaults in code) -----
LOG_LEVEL=INFO
WELCOME_DELETE_SECONDS=60
DEFAULT_REACTION_EMOJIS=🔥,❤️,👍,🎉,🥰,👏,💯,⚡

# ----- Keep-alive (Render auto-detects) -----
# KEEP_ALIVE_URL=https://your-app.onrender.com
